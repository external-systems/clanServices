{
  description = "External Systems custom clan services";

  inputs = {
    nixpkgs.follows = "clan-core/nixpkgs";
    data-mesher.follows = "clan-core/data-mesher";
    disko.follows = "clan-core/disko";
    nix-darwin.follows = "clan-core/nix-darwin";
    nix-select.follows = "clan-core/nix-select";
    sops-nix.follows = "clan-core/sops-nix";
    systems.follows = "clan-core/systems";

    clan-core = {
      url = "https://git.clan.lol/clan/clan-core/archive/main.tar.gz";
      inputs = {
        treefmt-nix.follows = "treefmt-nix";
        flake-parts.follows = "flake-parts";
      };
    };

    flake-parts = {
      url = "github:hercules-ci/flake-parts";
      inputs.nixpkgs-lib.follows = "nixpkgs";
    };

    treefmt-nix = {
      url = "github:numtide/treefmt-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # cert-manager chart (airgap deployment via the Rancher Helm controller).
    cert-manager-chart = {
      url = "https://charts.jetstack.io/charts/cert-manager-v1.21.2.tgz";
      flake = false;
    };

    # Sealed Secrets controller chart (airgap deployment via the Rancher
    # Helm controller; the signing keypair is pre-generated by clan vars).
    sealed-secrets-chart = {
      url = "https://github.com/bitnami-labs/sealed-secrets/releases/download/helm-v2.19.3/sealed-secrets-2.19.3.tgz";
      flake = false;
    };

    # Cilium and Traefik charts used by the k3s service. The Cilium chart
    # matches the nixpkgs rke2 1.35.8 airgap image bundle; the Traefik charts
    # match the k3s 1.36.5 packaged-component versions.
    cilium-chart = {
      url = "https://rke2-charts.rancher.io/assets/rke2-cilium/rke2-cilium-1.19.601.tgz";
      flake = false;
    };
    traefik-chart = {
      url = "https://k3s.io/k3s-charts/assets/traefik/traefik-40.1.5+up40.1.0.tgz";
      flake = false;
    };
    traefik-crd-chart = {
      url = "https://k3s.io/k3s-charts/assets/traefik-crd/traefik-crd-40.1.5+up40.1.0.tgz";
      flake = false;
    };

    # Gateway API experimental CRDs (v1.6.1) — pinned upstream source tree.
    # Nix unpacks the tarball to a directory; the service concatenates the
    # experimental-channel CRD files into one multi-doc manifest.
    gateway-api-crds = {
      url = "https://github.com/kubernetes-sigs/gateway-api/archive/refs/tags/v1.6.1.tar.gz";
      flake = false;
    };

    nix-unit = {
      url = "github:nix-community/nix-unit";
      inputs = {
        nixpkgs.follows = "nixpkgs";
        treefmt-nix.follows = "treefmt-nix";
      };
    };
    nix-github-actions = {
      url = "github:nix-community/nix-github-actions";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # MkDocs site + reveal.js slides for the spec/docs (see documentation/).
    presenting = {
      url = "github:external-systems/presenting";
      inputs = {
        nixpkgs.follows = "nixpkgs";
        flake-parts.follows = "flake-parts";
      };
    };
  };

  outputs =
    inputs@{
      self,
      flake-parts,
      ...
    }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "aarch64-darwin"
      ];

      debug = true;

      imports = [
        inputs.nix-unit.modules.flake.default
        (
          { lib, ... }:
          {
            # For debugging the flake
            flake.options.flake = lib.mkOption { default = self; };
          }
        )
        inputs.clan-core.flakeModules.default
        inputs.clan-core.flakeModules.testModule
        ./formatter.nix
        ./services/flake-module.nix
        ./lib/rancher-cluster/flake-module.nix
        ./tests/flake-module.nix
        ./documentation/module.nix
      ];

      perSystem =
        { pkgs, ... }:
        {
          nix-unit.inputs = inputs;

          devShells.default = pkgs.mkShell {
            # bash/jq/git are what scripts/update-pins.sh needs; the CI runner
            # image is a bare nix container that provides none of them.
            packages = [
              pkgs.treefmt
              pkgs.bash
              pkgs.jq
              pkgs.git
            ];
          };
        };
    };
}
